<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
	<string>io.github.est1994apdel.lumadrift-renderer</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME__/Library/Application Support/LumaDrift/LumaDrift Renderer.app/Contents/MacOS/LumaDriftRenderer</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/LumaDriftRenderer.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/LumaDriftRenderer.log</string>
</dict>
</plist>
